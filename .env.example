# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
OHO_DATABASE_URL=postgresql+psycopg://oho:CHANGE_ME_LONG_RANDOM_PASSWORD@db:5432/oho
OHO_PORT=8788

# Local development can use bearer auth. For production behind Cloudflare Access,
# set OHO_AUTH_MODE=cloudflare_access and configure the issuer, AUD tag and owner email.
OHO_AUTH_MODE=bearer
OHO_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN_AT_LEAST_24_CHARS
OHO_ENROLLMENT_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_ENROLLMENT_TOKEN

# Cloudflare Access mode (no OHO Admin Token needed when enabled)
OHO_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
OHO_ACCESS_AUD=REPLACE_WITH_OHO_ACCESS_APPLICATION_AUD_TAG
OHO_ADMIN_EMAIL=you@example.com
# Optional; defaults to OHO_ACCESS_ISSUER/cdn-cgi/access/certs
OHO_ACCESS_JWKS_URL=
